{
  "name": "asystent-ipet",
  "productName": "Asystent IPET",
  "version": "1.0.0",
  "description": "Asystent IPET – automatyczne tworzenie IPET, WOPFU i ocen funkcjonalnych dla uczniów SOSW z pomocą Claude. Dane uczniów zostają na komputerze.",
  "main": "src/main/main.js",
  "author": "z0z6",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "start": "electron .",
    "test": "node test/run-tests.js",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win portable --publish never",
    "android:add": "cap add android",
    "android:sync": "node scripts/copy-vendor.js && cap sync android"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@tesseract.js-data/pol": "^1.0.0",
    "docx": "^9.15.4",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0"
  },
  "build": {
    "appId": "pl.z0z6.asystentipet",
    "productName": "Asystent IPET",
    "artifactName": "Asystent-IPET-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/@capacitor/**/*"
    ],
    "afterPack": "build/afterPack.js",
    "linux": {
      "target": [
        "AppImage"
      ],
      "executableName": "asystent-ipet",
      "icon": "build/icon.png",
      "category": "Office",
      "synopsis": "Asystent IPET dla SOSW",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Asystent-IPET-${version}-portable.exe"
    }
  },
  "desktopName": "asystent-ipet.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/z0z6/ipet-wopfu-helper.git"
  }
}
